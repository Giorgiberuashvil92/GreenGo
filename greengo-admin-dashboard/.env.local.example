# cp .env.local.example .env.local

# ლოკალური backend (default dev)
# NEXT_PUBLIC_API_MODE=local

# ლოკალური admin → Railway პირდაპირ (CORS ტესტი, ჩვეულებრივ არ გჭირდებათ)
# NEXT_PUBLIC_API_MODE=production
# NEXT_PUBLIC_RAILWAY_API_URL=https://your-service.up.railway.app/api

# Vercel-ზე (Dashboard → Environment Variables):
# BACKEND_API_URL=https://greengo-production.up.railway.app
# (არ დაამატოთ /api — rewrite თავად ამატებს)

# Cloudinary credentials live in greengo-backend/.env for signed uploads.
