PORT=3001
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/greengo
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# Sender.ge — SMS API (Railway/სერვერზე დაამატეთ Environment Variables-ში)
SENDER_API_KEY=
SENDER_SMS_NO=2

# ერთი ფიქსირებული ნომერი, რომელსაც ყველა ახალი შეკვეთის შესახებ SMS მიუვა
ORDER_NOTIFICATION_PHONE=

FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=
FLITT_PUBLIC_API_URL=https://greengo-production.up.railway.app/api

# ოფციონალური: OTP bypass ნომერი (9 ციფრი). Default კოდშია +995555100000 → კოდი 1234
# DEV_BYPASS_PHONE_9=555100000
