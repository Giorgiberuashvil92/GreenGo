# Railway Environment Variables
# Add these variables in your Railway project settings
# Railway Dashboard -> Your Project -> Variables

# Server Configuration
PORT=3001

# MongoDB Database
# Railway will provide this automatically when you add MongoDB service
# Format: mongodb://username:password@host:port/database
MONGODB_URI=mongodb://localhost:27017/greengo

# JWT Authentication
# Generate a strong secret key for production
# You can use: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Cloudinary signed uploads
# Option A: single URL
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Option B: separate values
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS Configuration (optional)
# For production, specify your frontend domain
# CORS_ORIGIN=https://yourdomain.com
